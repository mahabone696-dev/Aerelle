rules_version = '2';

// Aerelle access rules. Every studio is isolated: its members, bookings, packages and orders are readable
// only by that studio's owners and by the member they belong to. Studios are private: nobody can list or
// search them. Someone holding a studio's link can open its profile, timetable (booking ids for taken
// spots, no names) and ratings, and nothing else.
//
// Layout
//   accounts/{uid}                       a person's own profile
//   slugs/{slug}                         reserves a studio's link name
//   studios/{sid}                        profile, class types, staff, package catalogue, ownerUids
//   studios/{sid}/sessions/{id}          timetable; booked[] and waitlist[] hold booking ids
//   studios/{sid}/members/{id}           a person's record at this studio (id = uid, or a placeholder
//                                         for someone the studio added who hasn't signed up yet)
//   studios/{sid}/bookings|packages|orders|ratings|promos/{id}
//   studios/{sid}/payment/duitnow        the studio's DuitNow QR image

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function verifiedEmail() {
      return signedIn() && request.auth.token.email_verified == true ? request.auth.token.email.lower() : null;
    }
    function studio(sid) { return get(/databases/$(database)/documents/studios/$(sid)).data; }
    function isOwner(sid) { return signedIn() && uid() in studio(sid).ownerUids; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function unchanged(key) { return !(key in changed()); }

    // A record that belongs to a placeholder member the signed-in person may take over: same verified email.
    function claimable(sid, memberId) {
      let m = get(/databases/$(database)/documents/studios/$(sid)/members/$(memberId)).data;
      return verifiedEmail() != null && m.email.lower() == verifiedEmail() && m.get('claimed', false) == false;
    }
    // Moving a record from a placeholder member to the signed-in account (and nothing else).
    // The package's order is the caller's own, unpaid, and saved in the same write.
    function newUnpaidOrderOf(sid, orderId) {
      let o = getAfter(/databases/$(database)/documents/studios/$(sid)/orders/$(orderId)).data;
      return o.userId == uid() && o.paid == false && !exists(/databases/$(database)/documents/studios/$(sid)/orders/$(orderId));
    }
    function isClaim(sid) {
      return changed().hasOnly(['userId']) && request.resource.data.userId == uid() && claimable(sid, resource.data.userId);
    }

    // Credits a member can spend or get back are tied to a real booking of theirs, so they can never give
    // themselves credits. A spend needs a booking being confirmed for this package in the same write; a
    // refund needs one of their bookings being cancelled in the same write; each for exactly its own credits.
    function bookingDoc(sid, bookingId) { return /databases/$(database)/documents/studios/$(sid)/bookings/$(bookingId); }
    function sessionCost(sid, sessionId) { return get(/databases/$(database)/documents/studios/$(sid)/sessions/$(sessionId)).data.cost; }
    // The package named by a new booking is reduced by exactly that booking's credits, in the same write.
    function spendsOnCreate(sid, b, bookingId) {
      let pkg = /databases/$(database)/documents/studios/$(sid)/packages/$(b.packageId);
      return exists(pkg) && get(pkg).data.userId == uid()
        && getAfter(pkg).data.spendFor == bookingId
        && getAfter(pkg).data.remaining == get(pkg).data.remaining - b.credits;
    }
    // A booking that takes a confirmed spot: its credits equal the class's cost, and a non-free class spends
    // exactly that from its package in the same write. Used for both a new booking and a waitlist claim.
    function confirmedSpend(sid, b, bookingId) {
      return b.credits == sessionCost(sid, b.sessionId)
        && (b.credits == 0 || spendsOnCreate(sid, b, bookingId));
    }
    function validSpend(sid, packageId, bookingId, amount) {
      let p = bookingDoc(sid, bookingId);
      let after = getAfter(p).data;
      return after.userId == uid() && after.status == 'booked' && after.packageId == packageId
        && after.get('credits', -1) == amount
        && (!exists(p) || get(p).data.status == 'waitlisted'); // newly booked, or promoted from the waitlist
    }
    function validRefund(sid, bookingId, amount) {
      let p = bookingDoc(sid, bookingId);
      return exists(p) && get(p).data.userId == uid() && get(p).data.status == 'booked' // was a confirmed spot
        && getAfter(p).data.status == 'cancelled' && getAfter(p).data.get('credits', 1) == amount; // now cancelled
    }
    // A member's own change to a package's remaining credits: either a verified spend or a verified refund.
    function memberCreditChange(sid, packageId) {
      let before = resource.data.remaining;
      let after = request.resource.data.remaining;
      return after >= 0 && after <= resource.data.total && (
        (changed().hasOnly(['remaining', 'spendFor']) && after < before
          && validSpend(sid, packageId, request.resource.data.spendFor, before - after))
        || (changed().hasOnly(['remaining', 'refundFrom']) && after > before
          && validRefund(sid, request.resource.data.refundFrom, after - before))
      );
    }

    match /accounts/{accountId} {
      allow read, write: if signedIn() && uid() == accountId;
    }

    match /slugs/{slug} {
      allow get: if true;   // open a studio by its exact link name
      allow list: if false; // but never list them
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['studioId', 'createdBy']) && request.resource.data.createdBy == uid();
    }

    match /studios/{sid} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerUids == [uid()] && request.resource.data.id == sid;
      allow update: if isOwner(sid) && request.resource.data.ownerUids.size() > 0 && unchanged('id') && unchanged('slug');
      allow delete: if false;

      // Timetable. booked[] and waitlist[] hold booking ids, in the order spots were taken.
      // Owners manage everything; a member may only add or remove one of their own bookings.
      match /sessions/{id} {
        allow read: if true;
        allow create, delete: if isOwner(sid);
        allow update: if isOwner(sid) || (signedIn() && changed().hasOnly(['booked', 'waitlist']) && selfOnly());

        function selfOnly() {
          let before = resource.data;
          let after = request.resource.data;
          return listChange(before.booked, after.booked) && listChange(before.waitlist, after.waitlist)
            && after.booked.size() <= before.capacity;
        }
        function ownBooking(bookingId) {
          return getAfter(/databases/$(database)/documents/studios/$(sid)/bookings/$(bookingId)).data.userId == uid();
        }
        // Unchanged; one of the caller's bookings appended at the end; or one of the caller's bookings removed.
        function listChange(before, after) {
          return after == before
            || (after.size() == before.size() + 1 && after == before.concat([after[after.size() - 1]])
                && !(after[after.size() - 1] in before) && ownBooking(after[after.size() - 1]))
            || (after.size() == before.size() - 1 && before.removeAll(after).size() == 1
                && after == before.removeAll(before.removeAll(after)) && ownBooking(before.removeAll(after)[0]));
        }
      }

      match /members/{memberId} {
        allow read: if isOwner(sid) || (signedIn() && memberId == uid())
          || (verifiedEmail() != null && resource.data.email.lower() == verifiedEmail());
        allow create: if isOwner(sid)
          || (signedIn() && memberId == uid() && request.resource.data.role == 'member' && request.resource.data.id == uid());
        allow update: if isOwner(sid)
          || (signedIn() && memberId == uid() && unchanged('role') && unchanged('id'));
        // A placeholder can be removed by the person claiming it, once its records are moved.
        allow delete: if isOwner(sid) || (memberId != uid() && claimable(sid, memberId));
      }

      match /bookings/{id} {
        allow read: if isOwner(sid) || (signedIn() && resource.data.userId == uid()) || claimable(sid, resource.data.userId);
        // A confirmed booking spends a credit at the class's real cost (see packages); a waitlist spot does
        // not, and a genuinely free (0-credit) class spends nothing. Credits must equal the class's cost, so
        // nobody can book a paid class "for free" by claiming 0 credits.
        allow create: if isOwner(sid)
          || (signedIn() && request.resource.data.userId == uid()
              && (request.resource.data.status == 'waitlisted' || confirmedSpend(sid, request.resource.data, id)));
        // Members may cancel or leave a waitlist (credits unchanged), or claim a freed spot (waitlisted ->
        // booked), which spends a credit the same way a new booking does. No other credit change is allowed.
        allow update: if isOwner(sid)
          || (signedIn() && resource.data.userId == uid() && unchanged('userId') && unchanged('sessionId') && unchanged('attendance')
              && (unchanged('credits')
                  || (resource.data.status == 'waitlisted' && request.resource.data.status == 'booked'
                      && confirmedSpend(sid, request.resource.data, id))))
          || isClaim(sid);
        allow delete: if isOwner(sid);
      }

      // Members can't give themselves classes: a new package from a member must be unpaid-backed (see orders),
      // start full, and afterwards only its remaining count may move within 0..total.
      match /packages/{id} {
        allow read: if isOwner(sid) || (signedIn() && resource.data.userId == uid()) || claimable(sid, resource.data.userId);
        allow create: if isOwner(sid)
          || (signedIn() && request.resource.data.userId == uid() && request.resource.data.remaining == request.resource.data.total
              && newUnpaidOrderOf(sid, request.resource.data.orderId));
        allow update: if isOwner(sid)
          || (signedIn() && resource.data.userId == uid() && memberCreditChange(sid, id))
          || isClaim(sid);
        allow delete: if isOwner(sid);
      }

      // Online orders from members are always unpaid until the studio marks them paid.
      match /orders/{id} {
        allow read: if isOwner(sid) || (signedIn() && resource.data.userId == uid()) || claimable(sid, resource.data.userId);
        allow create: if isOwner(sid)
          || (signedIn() && request.resource.data.userId == uid() && request.resource.data.paid == false && request.resource.data.source == 'Online');
        allow update: if isOwner(sid) || isClaim(sid);
        allow delete: if isOwner(sid);
      }

      match /ratings/{id} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.userId == uid()
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5;
        allow update: if isOwner(sid) || isClaim(sid);
        allow delete: if isOwner(sid);
      }

      // The studio's DuitNow QR (a small image) that members pay to at checkout.
      match /payment/{id} {
        allow read: if true;
        allow create, update: if isOwner(sid) && id == 'duitnow' && request.resource.data.keys().hasOnly(['qr', 'updatedAt'])
          && request.resource.data.qr is string && request.resource.data.qr.size() < 700000
          && request.resource.data.qr.matches('data:image/(png|jpeg|webp);base64,.*');
        allow delete: if isOwner(sid);
      }

      match /promos/{id} {
        allow read: if signedIn();
        allow create, delete: if isOwner(sid);
        // Members may only count a use when they redeem it.
        allow update: if isOwner(sid)
          || (signedIn() && changed().hasOnly(['uses']) && request.resource.data.uses == resource.data.uses + 1 && resource.data.active == true);
      }
    }

    // Name search. Each search key (the start of a word in a studio's name, 3+ letters) lists the studios
    // whose name has it. Someone has to type letters of a studio's name to find it: there is no full list,
    // and keys can't be listed. Each studio's owners maintain its own entries.
    match /searchIndex/{key}/studios/{sid} {
      allow read: if true;
      allow create, update: if isOwner(sid) && request.resource.data.sid == sid
        && request.resource.data.keys().hasOnly(['sid', 'slug', 'name', 'location']);
      allow delete: if isOwner(sid);
    }

    // Searches across studios: a person can find only their own memberships (and placeholders to claim by
    // verified email). Timetables and ratings can't be searched across studios.
    // A person's own packages across all their studios (for "classes left" on Find a studio).
    match /{path=**}/packages/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
    }
    match /{path=**}/members/{memberId} {
      allow read: if (signedIn() && resource.data.id == uid()) || (verifiedEmail() != null && resource.data.email == verifiedEmail());
    }
  }
}
